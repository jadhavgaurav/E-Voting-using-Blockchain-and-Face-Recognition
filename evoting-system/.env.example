# Copy to .env and fill in values. Do not commit .env or private keys.

# RPC URL for the target network (required for Sepolia deploy)
RPC_URL=

# Deployer private key (required for Sepolia deploy). Never commit.
DEPLOYER_PRIVATE_KEY=

# Chain ID: 31337 = Hardhat local, 11155111 = Sepolia
CHAIN_ID=31337

# Contract address (optional; can be read from contracts/deployments/default.json after deploy)
EVOTING_CONTRACT_ADDRESS=
