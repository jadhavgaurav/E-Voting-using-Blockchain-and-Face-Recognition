# ─────────────────────────────────────────────────────────────
# E-Voting platform — environment template. Copy to .env and fill.
# NEVER commit a real .env or any private key.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──
POSTGRES_USER=evoting
POSTGRES_PASSWORD=evoting
POSTGRES_DB=evoting
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async URL used by the API (asyncpg)
DATABASE_URL=postgresql+asyncpg://evoting:evoting@localhost:5432/evoting
# Sync URL used by Alembic migrations (psycopg)
DATABASE_URL_SYNC=postgresql+psycopg://evoting:evoting@localhost:5432/evoting

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Core API security ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
# Key-encryption key (KEK) protecting Aadhaar + custodial wallet keys at rest
DATA_ENCRYPTION_KEY=change-me-32-bytes-minimum-secret

# ── Biometrics service ──
BIOMETRICS_URL=http://localhost:8100
# Shared secret between core API and biometrics service (internal auth)
INTERNAL_SERVICE_TOKEN=change-me-internal-token
# core API biometrics adapter: "http" (real service) or "fake" (in-process, tests/dev)
BIOMETRICS_BACKEND=http
# embedder backend: "hash" (deterministic dev stub, no ML deps) or "insightface" (real ArcFace)
FACE_EMBEDDER=hash
# Face match threshold. With the "hash" stub a live camera can't match, so for a
# no-ML end-to-end demo set this to -1 (liveness is still enforced). Use ~0.42 with insightface.
FACE_MATCH_THRESHOLD=0.42

# ── Blockchain ──
# core API chain adapter: "web3" (real node) or "memory" (in-process, tests/dev)
CHAIN_BACKEND=web3
# Local dev chain (Hardhat node). Demo: Sepolia.
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
# Deployed EVoting contract address (written by the deploy script)
EVOTING_CONTRACT_ADDRESS=
# Relay gas to each voter's custodial wallet before their first vote (wei). 0 disables.
# 0.01 ETH default works out-of-the-box on a fresh local Hardhat node.
AUTO_FUND_WEI=10000000000000000

# ── Bootstrap admin (created by the seed script) ──
BOOTSTRAP_ADMIN_EMAIL=admin@evoting.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345
# Funder/deployer key — used to fund voter custodial wallets on testnet. TESTNET ONLY.
FUNDER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Sepolia (fill only when deploying to testnet)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# ── Web (Next.js) ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_EXPLORER_URL=https://sepolia.etherscan.io
