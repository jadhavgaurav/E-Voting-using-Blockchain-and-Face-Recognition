# Copy to `.env` and fill in. Never commit real secrets.

# Shared secret required on every non-health endpoint via the X-Internal-Token
# header. The core API must send the same value. REQUIRED in every environment;
# with an empty value the service fails closed and rejects all authed traffic.
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-string

# Embedder implementation: "hash" (default dev stub) or "insightface" (real model).
FACE_EMBEDDER=hash

# Cosine-similarity threshold at/above which a probe is considered a match.
FACE_MATCH_THRESHOLD=0.42

# Minimum number of frames required for the liveness challenge.
MIN_LIVENESS_FRAMES=2

# Server bind + logging.
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO
