{
  "name": "evoting",
  "version": "0.1.0",
  "private": true,
  "description": "E-Voting platform — blockchain + face recognition (production-grade rebuild)",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "contracts:test": "pnpm --filter @evoting/contracts test",
    "contracts:node": "pnpm --filter @evoting/contracts node",
    "web:dev": "pnpm --filter @evoting/web dev"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
